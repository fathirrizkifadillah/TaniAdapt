# ==============================================================================
# TaniAdapt — Environment Configuration Template
# Salin file ini menjadi .env.local untuk konfigurasi lingkungan lokal
# ==============================================================================

# URL API Prakiraan Cuaca Open-Meteo
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Batas waktu timeout permintaan API cuaca (milidetik)
VITE_API_TIMEOUT_MS=6500

# Mode fallback dataset kalibrasi lokal jika jaringan terputus di kebun/lahan
VITE_ENABLE_OFFLINE_FALLBACK=true

# Port pengembangan lokal Vite (opsional)
# PORT=5173
